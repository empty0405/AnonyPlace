# Common
NODE_ENV=development

# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL="postgresql://app:app@db:5432/app?schema=public"

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Patreon
